# =============================================================================
# Lumen backend configuration
# =============================================================================
#
# Copy to `backend/.env` and fill in the values. Every secret here is
# server-side: none of them ever reach the browser.
#
# The frontend reads its own `frontend/.env`; the two stacks do not
# share an env file.

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------

# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=info

# Comma-separated list of allowed origins.
# 5174 is the Lumen dev server and 5175 the one it takes when 5174 is
# busy; 8080 and 5173 are kept for the tools that default to them.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5175,http://localhost:8080,http://localhost:5173

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
#
# The connection string of the Postgres database. The backend talks to
# it directly, with SQLAlchemy.
#
# Locally that is the Docker container defined in docker-compose.yml.
# `./scripts/dev-db.sh up` creates the schema and prints the URL:
#
#   postgresql://postgres:postgres@127.0.0.1:55440/lumen_dev
#
# A bare `postgresql://` URL is fine: the backend picks the async
# driver for you.
#
# In a hosted environment, copy the connection string from the
# dashboard: Project Settings -> Database -> Connection string -> URI.
# Use the "Session pooler" one.
DATABASE_URL=

# Optional override for the database URL. Takes precedence over
# DATABASE_URL. Useful for pointing the test suite at a throwaway
# database without rewriting the URL above.
# DATABASE_URL_OVERRIDE=

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ----------------------------------------------------------------------------
# Auth (Phase 1)
# ----------------------------------------------------------------------------
#
# The backend issues its own JWTs and hashes passwords with Argon2id.
# Replace JWT_SECRET with a strong random value before deploying:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# The startup check refuses to boot in production while this is still
# the development default.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=lumen-api
JWT_AUDIENCE=lumen-frontend

# Access token lifetime in seconds (15 minutes).
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime in seconds (30 days).
REFRESH_TOKEN_TTL_SECONDS=2592000

# Argon2id parameters. The defaults are tuned for an interactive login
# on modest hardware (~50-80 ms per hash on a modern core).
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ----------------------------------------------------------------------------
# The files of the catalog
# ----------------------------------------------------------------------------
#
# The material of the editorial is written here while the project has no
# bucket to put it in. A relative path is resolved against the backend
# folder, so the default keeps the files inside the project.
PLATFORM_STORAGE_DIR=var/materiales

# ----------------------------------------------------------------------------
# Supabase (Realtime only)
# ----------------------------------------------------------------------------
#
# Supabase Auth is gone: this backend is the only issuer of tokens.
# What remains of Supabase is Realtime, for live chat.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ----------------------------------------------------------------------------
# Wompi (Colombian payments)
# ----------------------------------------------------------------------------
#
# The event secret is fetched from GET /merchants/{public_key} and
# cached per process. These keys are server-side only.
WOMPI_ENVIRONMENT=sandbox
WOMPI_API_BASE=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_KEY=
# WOMPI_WEBHOOK_SECRET=

# Public URL where Wompi delivers transaction events. Configured in the
# Wompi merchant dashboard. The backend exposes POST /v1/webhooks/wompi
# to receive them.
WOMPI_WEBHOOK_URL=
