# =============================================================================
# Lumen frontend configuration
# =============================================================================
#
# Copy to `frontend/.env` and fill in the values.
#
# The browser talks to the FastAPI backend for everything. These
# variables are public: they end up in the bundle, so nothing secret
# goes here.

# ----------------------------------------------------------------------------
# The backend
# ----------------------------------------------------------------------------
#
# The base URL of the FastAPI API. The dev server runs on port 8010
# (8000 belongs to the EduSuite stack on this machine).
VITE_API_URL=http://localhost:8010

# ----------------------------------------------------------------------------
# Supabase (Storage + Realtime only)
# ----------------------------------------------------------------------------
#
# The browser does not read from the database directly. Supabase is
# still used for file uploads and for live chat, and its RLS policies
# identify the caller through a short-lived token the backend mints.
#
# These are the browser-safe credentials: the publishable key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ----------------------------------------------------------------------------
# Wompi (Colombia)
# ----------------------------------------------------------------------------
#
# The checkout widget uses the public key to tokenize the payment. The
# secret keys live in the backend's environment, never here.
VITE_WOMPI_PUBLIC_KEY=
VITE_WOMPI_ENVIRONMENT=sandbox
